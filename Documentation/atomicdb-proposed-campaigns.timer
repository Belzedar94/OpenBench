# Companion of atomicdb-proposed-campaigns.service.
#
# EVERY 6 HOURS.  The campaigns page shows how old the numbers are, and a
# proposal does not change size fast enough to need more.  At 20 past, away
# from the top of the hour and from the conquest map build (05:30).
#
# Without Persistent=: a run missed by a reboot is not caught up, the next
# one comes at its time.

[Unit]
Description=Measure AtomicDB proposed campaigns every 6 hours

[Timer]
OnCalendar=*-*-* 00/6:20:00 UTC
AccuracySec=5min
RandomizedDelaySec=5min
Persistent=false
Unit=atomicdb-proposed-campaigns.service

[Install]
WantedBy=timers.target
