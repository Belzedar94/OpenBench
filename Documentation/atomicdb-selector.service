# AtomicDB selector refresher — example systemd unit.
#
# Copy to /etc/systemd/system/atomicdb-selector.service, adjust User, paths and
# the environment block, then:
#
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now atomicdb-selector
#     journalctl -u atomicdb-selector -f
#
# What it does: recomputes the ``priority`` column that orders the AtomicDB
# work queue.  That computation is a Dijkstra over the entire DAG plus two
# in-memory dictionaries of every position and edge; it used to run inside
# /atomicdb/api/lease, which meant every worker poll could pay for it, in each
# of the five gunicorn processes independently.
#
# It also publishes the PUBLIC COUNTERS of the front page into the shared
# cache at the end of every pass — three full scans of ``Position`` and the
# closure-attribution counts, which used to be paid inside a visitor's request
# (2.5 s measured) and are now paid once a minute for the whole site.  That is
# also why the cache has to be shared: a web worker cannot read something
# published into another process's memory (§ OpenSite/cache.py).
#
# If it is stopped, NOTHING breaks: the queue keeps being served in the order
# the last refresh left, tasks keep being leased and submitted, and priorities
# simply go stale.  Stale priorities cost relevance, not correctness.  The
# counters degrade the same way: the web measures them itself, one process at
# a time behind a lock, so the front page gets slower and stays truthful.
#
# The cache it publishes into is ``OPENBENCH_REDIS_URL`` (default
# redis://127.0.0.1:6379/1).  If the web process is pointed somewhere else,
# THIS process has to be pointed at the same place or it will be publishing
# into a cache nobody reads.
#
# Start order: after `manage.py migrate`.  Independent of the web service and
# of atomicdb-ingest.
#
# ONE process, deliberately.  Two would compute the same global pass twice and
# fight for the SQLite write lock.
#
# Emergency fallback: set ATOMICDB_INLINE_SELECTOR=True in the WEB process's
# environment and restart it.  The lease path then refreshes priorities inline
# again, through this same code, and this service can stay stopped.
#
# Adversarial arms (dn repair + F0 solves on fragile mate claims): OFF unless
# ATOMICDB_ADVERSARIAL=1 is in THIS process's environment.  Turn them on only
# after `capture_atomicdb_progress` has written the reference row — the whole
# package exists to measure the difference, and the "before" has to be taken
# with the code deployed and the arms quiet.  See
# docs/atomicdb-progress-instrumentation.md.

[Unit]
Description=AtomicDB selector priority refresher
Documentation=https://github.com/Belzedar94/OpenBench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openbench
Group=openbench
WorkingDirectory=/home/openbench/OpenBench

# Same environment the web process uses. The secret key is only needed
# because settings import it; the refresher serves no HTTP.
Environment=OPENBENCH_DEBUG=False
Environment=PYTHONUNBUFFERED=1
# Environment=ATOMICDB_ADVERSARIAL=1
# EnvironmentFile=/etc/openbench/openbench.env

ExecStart=/home/openbench/OpenBench/.venv/bin/python manage.py \
    refresh_selector --loop --interval 60

# A refresh interrupted mid-pass leaves the priorities it had already written;
# they are a heuristic ordering, so a partial pass is harmless.
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
