{
    "private" : false,
    "nps"     : 380000,
    "source"  : "https://github.com/Belzedar94/Spell-Stockfish",

    "build" : {
        "path"      : "src",
        "compilers" : ["g++"],
        "cpuflags"  : ["AVX2", "FMA", "POPCNT"],
        "systems"   : ["Windows", "Linux"]
    },

    "test_presets" : {

        "default" : {
            "base_branch"     : "master",
            "book_name"       : "spell_openings.epd",
            "test_bounds"     : "[1.00, 6.00]",
            "test_confidence" : "[0.05, 0.05]",
            "win_adj"         : "movecount=4 score=800",
            "draw_adj"        : "movenumber=40 movecount=8 score=10"
        },

        "STC" : {
            "both_options"      : "Threads=1 Hash=32",
            "both_time_control" : "8.0+0.08",
            "workload_size"     : 32
        },

        "LTC" : {
            "both_options"      : "Threads=1 Hash=128",
            "both_time_control" : "40.0+0.4",
            "workload_size"     : 8
        },

        "STC regression" : {
            "both_options"      : "Threads=1 Hash=32",
            "both_time_control" : "8.0+0.08",
            "workload_size"     : 32,
            "test_bounds"       : "[-5.00, 0.00]"
        },

        "LTC regression" : {
            "both_options"      : "Threads=1 Hash=128",
            "both_time_control" : "40.0+0.4",
            "workload_size"     : 8,
            "test_bounds"       : "[-5.00, 0.00]"
        },

        "SMP STC" : {
            "both_options"      : "Threads=8 Hash=64",
            "both_time_control" : "10.0+0.1",
            "workload_size"     : 16
        },

        "SMP LTC" : {
            "both_options"      : "Threads=8 Hash=256",
            "both_time_control" : "30.0+0.3",
            "workload_size"     : 8
        },

        "STC progtest" : {
            "both_options"      : "Threads=1 Hash=32",
            "both_time_control" : "8.0+0.08",
            "workload_size"     : 32,
            "test_max_games"    : 3000
        },

        "LTC progtest" : {
            "both_options"      : "Threads=1 Hash=128",
            "both_time_control" : "60.0+0.6",
            "workload_size"     : 8,
            "test_max_games"    : 1000
        }
    },

    "tune_presets" : {

        "default" : {
            "book_name" : "spell_openings.epd",
            "win_adj"   : "movecount=4 score=800",
            "draw_adj"  : "movenumber=40 movecount=8 score=10"
        },

        "SPSA STC" : {
            "dev_options"      : "Threads=1 Hash=32",
            "dev_time_control" : "8.0+0.08"
        },

        "SPSA VSTC" : {
            "dev_options"      : "Threads=1 Hash=16",
            "dev_time_control" : "2.0+0.02"
        }
    },

    "datagen_presets" : {

        "default" : {
            "book_name"                     : "spell_openings.epd",
            "datagen_command"               : "datagen book {BOOK} nodes 1000 count {COUNT} threads {THREADS} seed {SEED} out {OUT}",
            "datagen_total_count"           : 16000,
            "datagen_positions_per_chunk"   : 2000,
            "datagen_base_seed"             : 1
        }
    }
}
