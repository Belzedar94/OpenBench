-	return StandardBoard::result();
+	// Lichess Horde terminal precedence is intentional.
+	if (!hasLegalMove && side == Side::Black && inCheck(Side::Black))
+		return Result(Result::Win, Side::White, tr("White mates"));
+
+	if (!hasMaterial(Side::White))
+		return Result(Result::Win, Side::Black,
+			      tr("Black wins by Horde extinction"));
+
+	if (!hasLegalMove)
+		return Result(Result::Draw, Side::NoSide, tr("Draw by stalemate"));
+
+	if (hordeClosedPosition())
+		return Result(Result::Draw, Side::NoSide,
+			      tr("Draw by closed Horde position"));
+
+	if (reversibleMoveCount() >= 100)
+		return Result(Result::Draw, Side::NoSide,
+			      tr("Draw by fifty moves rule"));
+
+	if (repeatCount() >= 4)
+		return Result(Result::Draw, Side::NoSide,
+			      tr("Draw by fivefold repetition"));
+
+	return Result();
+}
+
+bool HordeBoard::winPossible(Side side) const
+{
+	Q_ASSERT(!side.isNull());
+	if (sideHasInsufficientWinningMaterial(side))
+		return false;
+
+	HordeBoard probe(*this);
+	return !probe.hordeClosedPosition();
+}
+
+bool HordeBoard::sideHasInsufficientWinningMaterial(Side side) const
+{
+	Q_ASSERT(!side.isNull());
+
+	// Black can always win by capturing every White piece.
+	if (side == Side::Black)
+		return false;
+
+	const auto material = [&](Side materialSide) {
+		HordeMaterial value;
+		for (int i = 0; i < arraySize(); ++i)
+		{
+			const Piece piece = pieceAt(i);
+			if (!piece.isValid() || piece.side() != materialSide)
+				continue;
+
+			switch (piece.type())
+			{
+			case Pawn:
+				++value.pawn;
+				break;
+			case Knight:
+				++value.knight;
+				break;
+			case Bishop:
+				if (chessSquare(i).color() == Square::Light)
+					++value.bishopLight;
+				else
+					++value.bishopDark;
+				break;
+			case Rook:
+				++value.rook;
+				break;
+			case Queen:
+				++value.queen;
+				break;
+			case King:
+				++value.king;
+				break;
+			default:
+				break;
+			}
+		}
+		return value;
+	};
+
+	return hordeMaterialIsInsufficient(material(Side::White),
+					   material(Side::Black));
+}
+
+bool HordeBoard::hordeClosedPosition()
+{
+	int hordeCount = 0;
+	int hordeSquare = 0;
+	for (int i = 0; i < arraySize(); ++i)
+	{
+		const Piece piece = pieceAt(i);
+		if (piece.isValid() && piece.side() == Side::White)
+		{
+			++hordeCount;
+			hordeSquare = i;
+		}
+	}
+
+	if (hordeCount == 0)
+		return false;
+
+	const bool mateInOne = hordeCount == 1
+				    && inCheck(Side::White, hordeSquare);
+	if (mateInOne)
+		return false;
+
+	if (sideToMove() == Side::White)
+		return legalMoves().isEmpty();
+
+	const QVector<Move> blackMoves = legalMoves();
+	if (blackMoves.isEmpty())
+		return !inCheck(Side::Black);
+
+	for (const Move& move : blackMoves)
+	{
+		makeMove(move);
+		const bool whiteCanMove = !legalMoves().isEmpty();
+		undoMove();
+		if (whiteCanMove)
+			return false;
+	}
+
+	return true;
+}
+
+bool HordeBoard::parseCastlingRights(QChar c)
+{
+	if (c.isUpper())
+		return false;
+	return StandardBoard::parseCastlingRights(c);
+}
+
+bool HordeBoard::pawnDoubleStepCreatesEnPassant(Side side,
+						 int sourceSquare) const
+{
+	return side != Side::White || chessSquare(sourceSquare).rank() != 0;
 }
 
