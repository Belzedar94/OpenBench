+void tst_Board::hordeMaterialCorpus()
+{
+	setVariant("horde");
+	Chess::HordeBoard* board = dynamic_cast<Chess::HordeBoard*>(m_board);
+	QVERIFY(board != nullptr);
+
+	QFile file(QStringLiteral(CUTECHESS_TEST_DATA_DIR)
+		   + "/horde_insufficient_material.csv");
+	QVERIFY2(file.open(QIODevice::ReadOnly), qPrintable(file.errorString()));
+	const QByteArray payload = file.readAll();
+	QCOMPARE(QCryptographicHash::hash(payload, QCryptographicHash::Sha256).toHex(),
+		 QByteArray("1f01b4fd3ab6066efe5a96a2ae4e0df5074fb99377d7caaa2acba04d453d53cc"));
+
+	int rowCount = 0;
+	for (QByteArray line : payload.split('\n'))
+	{
+		if (line.endsWith('\r'))
+			line.chop(1);
+		if (line.isEmpty())
+			continue;
+
+		++rowCount;
+		const QList<QByteArray> fields = line.split(',');
+		QVERIFY2(fields.size() == 3,
+			 qPrintable(QString("Malformed corpus row %1").arg(rowCount)));
+		const QString fen = QString::fromUtf8(fields.at(0));
+		QVERIFY2(board->setFenString(fen),
+			 qPrintable(QString("Invalid corpus FEN at row %1: %2")
+				    .arg(rowCount).arg(fen)));
+		const bool expected = fields.at(1) == "true";
+		QCOMPARE(board->sideHasInsufficientWinningMaterial(Chess::Side::White),
+			 expected);
+		QVERIFY(!board->sideHasInsufficientWinningMaterial(Chess::Side::Black));
+	}
+
+	QCOMPARE(rowCount, 21996);
+}
