+void tst_Board::hordeRuleContract()
+{
+	setVariant("horde");
+	Chess::HordeBoard* board = dynamic_cast<Chess::HordeBoard*>(m_board);
+	QVERIFY(board != nullptr);
+
+	// Horde FENs have no White king and exactly one Black king.
+	QVERIFY(!board->setFenString("4k3/8/8/8/8/8/8/4K3 w - - 0 1"));
+	QVERIFY(!board->setFenString("8/8/8/8/8/8/8/P7 w - - 0 1"));
+	QVERIFY(!board->setFenString("4k2k/8/8/8/8/8/8/P7 w - - 0 1"));
+	QVERIFY(!board->setFenString("4k3/8/8/8/8/8/8/R7 w K - 0 1"));
+	QVERIFY(board->setFenString(
+		"4k3/pp4q1/3P2p1/8/P3PP2/PPP2r2/PPP5/PPPP4 b - - 0 1"));
+	QCOMPARE(board->legalMoves().size(), 30);
+
+	// A first-rank double step is legal but never grants an en-passant capture.
+	QVERIFY(board->setFenString(
+		"k7/5p2/4p2P/3p2P1/2p2P2/1p2P2P/p2P2P1/2P2P2 w - - 0 1"));
+	Chess::Move move = board->moveFromString("c1c3");
+	QVERIFY(board->isLegalMove(move));
+	board->makeMove(move);
+	QCOMPARE(board->fenString().split(' ').at(3), QString("-"));
+	move = board->moveFromString("b3c2");
+	QVERIFY(move.isNull() || !board->isLegalMove(move));
+	board->undoMove();
+
+	// Ordinary Horde en passant remains available in the normal region.
+	QVERIFY(board->setFenString("4k3/5p2/8/4P3/8/8/8/8 b - - 0 1"));
+	move = board->moveFromString("f7f5");
+	QVERIFY(board->isLegalMove(move));
+	board->makeMove(move);
+	QCOMPARE(board->fenString().split(' ').at(3), QString("f6"));
+	move = board->moveFromString("e5f6");
+	QVERIFY(board->isLegalMove(move));
+	board->undoMove();
+
+	// Only Black can castle.
+	QVERIFY(board->setFenString("r3k2r/8/8/8/8/8/8/P7 b kq - 0 1"));
+	QVERIFY(board->isLegalMove(board->moveFromString("e8g8")));
+	QVERIFY(board->isLegalMove(board->moveFromString("e8c8")));
+
+	// Material and a closed position are independent timeout predicates.
+	QVERIFY(board->setFenString("4k1n1/8/8/8/8/8/8/R7 w - - 0 1"));
+	QVERIFY(!board->sideHasInsufficientWinningMaterial(Chess::Side::Black));
+	QVERIFY(!board->winPossible(Chess::Side::White));
+	QVERIFY(board->winPossible(Chess::Side::Black));
+	QVERIFY(board->setFenString("4k3/7p/8/8/8/8/8/Q7 w - - 0 1"));
+	QVERIFY(board->winPossible(Chess::Side::White));
+	QVERIFY(board->setFenString("8/p7/pk6/P7/P7/8/8/8 b - - 0 1"));
+	QVERIFY(!board->winPossible(Chess::Side::White));
+	QVERIFY(!board->winPossible(Chess::Side::Black));
+
+	// A threatened last Horde piece is not misclassified as a fortress.
+	QVERIFY(board->setFenString("7k/8/8/8/8/8/r7/P7 b - - 0 1"));
+	QCOMPARE(board->result().toShortString(), QString("*"));
+	move = board->moveFromString("a2a1");
+	QVERIFY(board->isLegalMove(move));
+	board->makeMove(move);
+	QCOMPARE(board->result().toShortString(), QString("0-1"));
+
+	// Four occurrences are not automatic; five occurrences are.
+	QVERIFY(board->setFenString("4k2r/8/8/8/8/8/8/R7 w - - 0 1"));
+	const QStringList cycle = { "a1a2", "h8h7", "a2a1", "h7h8" };
+	for (int repetition = 0; repetition < 3; ++repetition)
+	{
+		for (const QString& moveString : cycle)
+		{
+			move = board->moveFromString(moveString);
+			QVERIFY(board->isLegalMove(move));
+			board->makeMove(move);
+		}
+	}
+	QCOMPARE(board->repeatCount(), 3);
+	QCOMPARE(board->result().toShortString(), QString("*"));
+	for (const QString& moveString : cycle)
+	{
+		move = board->moveFromString(moveString);
+		QVERIFY(board->isLegalMove(move));
+		board->makeMove(move);
+	}
+	QCOMPARE(board->repeatCount(), 4);
+	QCOMPARE(board->result().toShortString(), QString("1/2-1/2"));
+}
